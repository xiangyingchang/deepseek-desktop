{
  "name": "dsh-stack",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Stack reproducibility, verification, and distribution layer for DeepSeek Desktop.",
  "homepage": "https://github.com/xiangyingchang/deepseek-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiangyingchang/deepseek-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/xiangyingchang/deepseek-desktop/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dsh-stack": "tsx packages/cli/src/main.ts",
    "test": "node --import tsx --test packages/core/tests/*.test.ts packages/cli/tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:integration": "tsx packages/cli/tests/integration.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
